{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofabird.app/protocol/v1/messages.schema.json",
  "title": "sofabird protocol v1 messages",
  "description": "Every message is a JSON object with a t (type) field. It is sent as one WebSocket frame or one NDJSON line.",
  "type": "object",
  "required": [
    "t"
  ],
  "properties": {
    "t": {
      "type": "string"
    },
    "id": {
      "type": "string"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/welcome"
    },
    {
      "$ref": "#/$defs/cmd"
    },
    {
      "$ref": "#/$defs/sys"
    },
    {
      "$ref": "#/$defs/ok"
    },
    {
      "$ref": "#/$defs/err"
    },
    {
      "$ref": "#/$defs/browse"
    },
    {
      "$ref": "#/$defs/entries"
    },
    {
      "$ref": "#/$defs/getState"
    },
    {
      "$ref": "#/$defs/getPlaylist"
    },
    {
      "$ref": "#/$defs/playlist"
    },
    {
      "$ref": "#/$defs/getTracks"
    },
    {
      "$ref": "#/$defs/tracks"
    },
    {
      "$ref": "#/$defs/getAudioDevices"
    },
    {
      "$ref": "#/$defs/audioDevices"
    },
    {
      "$ref": "#/$defs/displays"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/ping"
    },
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/pong"
    },
    {
      "$ref": "#/$defs/beacon"
    },
    {
      "$ref": "#/$defs/getHistory"
    },
    {
      "$ref": "#/$defs/history"
    },
    {
      "$ref": "#/$defs/historyUpdate"
    },
    {
      "$ref": "#/$defs/historyClear"
    },
    {
      "$ref": "#/$defs/getLibrary"
    },
    {
      "$ref": "#/$defs/library"
    },
    {
      "$ref": "#/$defs/getShow"
    },
    {
      "$ref": "#/$defs/show"
    }
  ],
  "$defs": {
    "hello": {
      "type": "object",
      "required": [
        "t",
        "v",
        "device"
      ],
      "properties": {
        "t": {
          "const": "hello"
        },
        "v": {
          "const": 1
        },
        "device": {
          "type": "object",
          "required": [
            "name",
            "id"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "locale": {
              "type": [
                "string",
                "null"
              ],
              "description": "BCP 47 tag of the phone UI language; err.msg is rendered in it"
            }
          }
        },
        "token": {
          "type": [
            "string",
            "null"
          ]
        },
        "pairCode": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{6}$"
        }
      }
    },
    "welcome": {
      "type": "object",
      "required": [
        "t",
        "v",
        "name",
        "id",
        "caps",
        "vlc"
      ],
      "properties": {
        "t": {
          "const": "welcome"
        },
        "v": {
          "const": 1
        },
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "caps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cap"
          }
        },
        "token": {
          "type": "string"
        },
        "vlc": {
          "$ref": "#/$defs/vlcInfo"
        },
        "bt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9A-F]{2}:){5}[0-9A-F]{2}$",
          "description": "Bluetooth adapter address of the PC (RFCOMM service 47fe5bd6-98ad-4d9f-9812-174b3394037d)"
        },
        "macs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([0-9A-F]{2}:){5}[0-9A-F]{2}$"
          },
          "description": "MAC addresses of the connected adapters that will wake the PC from sleep, wired first (Wake-on-LAN); [] - it cannot be woken; absent - not known yet"
        },
        "tls": {
          "type": "object",
          "required": [
            "port",
            "sha256"
          ],
          "properties": {
            "port": {
              "type": "integer"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9A-F]{64}$"
            }
          },
          "description": "The encrypted WebSocket (wss://host:port/ws) and the SHA-256 of its self-signed certificate, which a phone pins"
        }
      }
    },
    "cap": {
      "enum": [
        "currentTrack",
        "chapterNames",
        "audioDevices",
        "pushEvents",
        "launchVlc",
        "windowControl",
        "power",
        "systemVolume",
        "metadata",
        "bluetooth",
        "history",
        "library",
        "moonlight",
        "youtube",
        "sleepTimer",
        "input"
      ]
    },
    "vlcInfo": {
      "type": "object",
      "required": [
        "running"
      ],
      "properties": {
        "running": {
          "type": "boolean"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "apiVersion": {
          "type": [
            "integer",
            "null"
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "status": {
          "enum": [
            "notInstalled",
            "notRunning",
            "starting",
            "noControl",
            "running"
          ]
        }
      }
    },
    "cmd": {
      "type": "object",
      "required": [
        "t",
        "id",
        "name"
      ],
      "properties": {
        "t": {
          "const": "cmd"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "enum": [
            "play",
            "pause",
            "togglePause",
            "stop",
            "next",
            "prev",
            "seek",
            "volume",
            "mute",
            "rate",
            "track",
            "chapter",
            "title",
            "delay",
            "fullscreen",
            "aspect",
            "open",
            "playlistRemove",
            "playlistClear",
            "random",
            "loop",
            "repeat",
            "launch",
            "quit",
            "resume",
            "dismissNext"
          ]
        },
        "args": {
          "type": "object"
        }
      }
    },
    "sys": {
      "type": "object",
      "required": [
        "t",
        "id",
        "name"
      ],
      "properties": {
        "t": {
          "const": "sys"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "enum": [
            "audioDevice",
            "displayPower",
            "keepAwake",
            "listDisplays",
            "moonlightStart",
            "moonlightStop",
            "moveToDisplay",
            "preferredDisplay",
            "shutdown",
            "sleep",
            "systemVolume",
            "youtube",
            "youtubeAdBlock",
            "youtubeOpen",
            "youtubeSponsorBlock"
          ]
        },
        "args": {
          "type": "object"
        }
      }
    },
    "ok": {
      "type": "object",
      "required": [
        "t",
        "id"
      ],
      "properties": {
        "t": {
          "const": "ok"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "err": {
      "type": "object",
      "required": [
        "t",
        "code",
        "msg"
      ],
      "properties": {
        "t": {
          "const": "err"
        },
        "id": {
          "type": "string"
        },
        "code": {
          "enum": [
            "pairing_required",
            "unauthorized",
            "bad_request",
            "vlc_not_running",
            "vlc_error",
            "unsupported",
            "internal"
          ]
        },
        "msg": {
          "type": "string"
        }
      }
    },
    "browse": {
      "type": "object",
      "required": [
        "t",
        "id",
        "uri"
      ],
      "properties": {
        "t": {
          "const": "browse"
        },
        "id": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "entries": {
      "type": "object",
      "required": [
        "t",
        "id",
        "uri",
        "items"
      ],
      "properties": {
        "t": {
          "const": "entries"
        },
        "id": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "uri",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "uri": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "dir",
                  "file"
                ]
              },
              "size": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "modified": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "progress": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "finished": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "getState": {
      "type": "object",
      "required": [
        "t",
        "id"
      ],
      "properties": {
        "t": {
          "const": "getState"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "getPlaylist": {
      "type": "object",
      "required": [
        "t",
        "id"
      ],
      "properties": {
        "t": {
          "const": "getPlaylist"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "playlist": {
      "type": "object",
      "required": [
        "t",
        "id",
        "items"
      ],
      "properties": {
        "t": {
          "const": "playlist"
        },
        "id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/playlistItem"
          }
        }
      }
    },
    "playlistItem": {
      "type": "object",
      "required": [
        "plId",
        "name",
        "uri"
      ],
      "properties": {
        "plId": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "durationSec": {
          "type": [
            "integer",
            "null"
          ]
        },
        "current": {
          "type": "boolean"
        }
      }
    },
    "getTracks": {
      "type": "object",
      "required": [
        "t",
        "id"
      ],
      "properties": {
        "t": {
          "const": "getTracks"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "tracks": {
      "type": "object",
      "required": [
        "t",
        "id"
      ],
      "properties": {
        "t": {
          "const": "tracks"
        },
        "id": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/tracksBody"
        }
      ]
    },
    "tracksBody": {
      "type": "object",
      "properties": {
        "audio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "subtitle": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "video": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "currentAudio": {
          "type": [
            "integer",
            "null"
          ]
        },
        "currentSubtitle": {
          "type": [
            "integer",
            "null"
          ]
        },
        "currentVideo": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "track": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "lang": {
          "type": [
            "string",
            "null"
          ]
        },
        "codec": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "getAudioDevices": {
      "type": "object",
      "required": [
        "t",
        "id"
      ],
      "properties": {
        "t": {
          "const": "getAudioDevices"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "audioDevices": {
      "type": "object",
      "required": [
        "t",
        "id",
        "items"
      ],
      "properties": {
        "t": {
          "const": "audioDevices"
        },
        "id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "current": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "displays": {
      "type": "object",
      "required": [
        "t",
        "id",
        "items"
      ],
      "properties": {
        "t": {
          "const": "displays"
        },
        "id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "id",
              "name"
            ],
            "properties": {
              "index": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "primary": {
                "type": "boolean"
              },
              "bounds": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer"
                  },
                  "y": {
                    "type": "integer"
                  },
                  "width": {
                    "type": "integer"
                  },
                  "height": {
                    "type": "integer"
                  }
                }
              },
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "internal",
                  "external",
                  "unknown"
                ]
              },
              "current": {
                "type": "boolean"
              },
              "preferred": {
                "type": "boolean"
              }
            }
          }
        },
        "preferredId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "t",
        "vlc",
        "playback"
      ],
      "properties": {
        "t": {
          "const": "state"
        },
        "vlc": {
          "$ref": "#/$defs/vlcInfo"
        },
        "playback": {
          "type": "object",
          "required": [
            "state",
            "time",
            "length",
            "position",
            "rate",
            "updatedAt"
          ],
          "properties": {
            "state": {
              "enum": [
                "playing",
                "paused",
                "stopped"
              ]
            },
            "time": {
              "type": "integer"
            },
            "length": {
              "type": "integer"
            },
            "position": {
              "type": "number"
            },
            "rate": {
              "type": "number"
            },
            "updatedAt": {
              "type": "integer",
              "description": "unix ms on the PC"
            }
          }
        },
        "item": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "plId": {
              "type": [
                "integer",
                "null"
              ]
            },
            "uri": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "artUrl": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "tracks": {
          "$ref": "#/$defs/tracksBody"
        },
        "chapters": {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer"
            },
            "count": {
              "type": "integer"
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "titles": {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer"
            },
            "count": {
              "type": "integer"
            }
          }
        },
        "volume": {
          "type": "object",
          "required": [
            "value",
            "muted"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "muted": {
              "type": "boolean"
            }
          }
        },
        "video": {
          "type": "object",
          "properties": {
            "fullscreen": {
              "type": "boolean"
            },
            "aspect": {
              "type": "string"
            }
          }
        },
        "delays": {
          "type": "object",
          "properties": {
            "audio": {
              "type": "number"
            },
            "subtitle": {
              "type": "number"
            }
          }
        },
        "flags": {
          "type": "object",
          "properties": {
            "random": {
              "type": "boolean"
            },
            "loop": {
              "type": "boolean"
            },
            "repeat": {
              "type": "boolean"
            }
          }
        },
        "system": {
          "type": "object",
          "properties": {
            "volume": {
              "type": "integer"
            },
            "muted": {
              "type": "boolean"
            },
            "audioDevice": {
              "type": [
                "string",
                "null"
              ]
            },
            "display": {
              "type": [
                "integer",
                "null"
              ]
            },
            "keepAwake": {
              "type": "boolean"
            },
            "displayId": {
              "type": [
                "string",
                "null"
              ]
            },
            "preferredDisplayId": {
              "type": [
                "string",
                "null"
              ]
            },
            "moonlightHost": {
              "type": [
                "string",
                "null"
              ],
              "description": "The computer Moonlight streams from (the first paired one); absent - none paired"
            },
            "moonlightStreaming": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "A Moonlight stream is on the screen; absent - Moonlight is not installed"
            },
            "sleepTimer": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "endsAt": {
                  "type": "integer",
                  "description": "Unix time in ms when it runs out"
                },
                "endOfItem": {
                  "type": "boolean",
                  "description": "It runs out when what plays now ends"
                },
                "action": {
                  "enum": [
                    "pause",
                    "sleep"
                  ]
                }
              },
              "description": "The sleep timer (sys sleepTimer); absent - off"
            }
          }
        },
        "resume": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "uri": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "position": {
              "type": "integer"
            },
            "length": {
              "type": "integer"
            },
            "pending": {
              "type": "boolean"
            }
          }
        },
        "next": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "uri": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          }
        },
        "history": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "revision": {
              "type": "integer"
            }
          }
        },
        "library": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "revision": {
              "type": "integer"
            },
            "scanning": {
              "type": "boolean"
            }
          }
        },
        "youtube": {
          "type": [
            "object",
            "null"
          ],
          "description": "YouTube in the TV browser (cap youtube)",
          "properties": {
            "open": {
              "type": "boolean"
            },
            "playing": {
              "type": "boolean"
            },
            "videoId": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "channel": {
              "type": [
                "string",
                "null"
              ]
            },
            "time": {
              "type": [
                "number",
                "null"
              ],
              "description": "seconds, at the time the state was built"
            },
            "length": {
              "type": [
                "number",
                "null"
              ],
              "description": "seconds"
            },
            "canNext": {
              "type": "boolean"
            },
            "canPrevious": {
              "type": "boolean"
            },
            "ad": {
              "type": "boolean",
              "description": "an ad plays (TV extension); time/length are the ad's"
            },
            "adSkippable": {
              "type": "boolean",
              "description": "the ad's Skip button is shown (sys youtube skipAd)"
            },
            "adBlock": {
              "type": "boolean",
              "description": "ads are blocked with uBlock Origin (sys youtubeAdBlock)"
            },
            "sponsorBlock": {
              "type": "boolean",
              "description": "sponsor segments are skipped with SponsorBlock (sys youtubeSponsorBlock)"
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "t",
        "name"
      ],
      "properties": {
        "t": {
