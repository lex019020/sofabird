<Project>
  <!-- Shared by all companion projects. -->
  <PropertyGroup>
    <!-- .NET code analysis at the "recommended" level, pinned to the .NET 10 rule set so that a newer SDK on CI does
         not bring new rules unannounced; exceptions with reasons are in .editorconfig. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Needed for IDE0005 (unnecessary usings) to be reported in the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
