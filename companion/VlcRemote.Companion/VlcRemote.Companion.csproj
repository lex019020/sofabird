<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VlcRemote.Companion</RootNamespace>
    <AssemblyName>VlcRemote.Companion</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Версия берётся из файла VERSION в корне репозитория; CI добавляет суффикс: -p:VersionSuffix=beta.42 -->
    <VersionPrefix>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</VersionPrefix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>VLC Remote Companion</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Publish: see README (dotnet publish, win-x64, framework-dependent, single file) -->
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VlcRemote.Core\VlcRemote.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Наши Lua-страницы (companion/lua/requests) встраиваются как ресурсы и устанавливаются LuaPagesInstaller. -->
    <EmbeddedResource Include="..\lua\requests\tracks.json" LogicalName="lua.requests.tracks.json" />
    <EmbeddedResource Include="..\lua\requests\setvar.json" LogicalName="lua.requests.setvar.json" />
  </ItemGroup>

</Project>
