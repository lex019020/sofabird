<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Sofabird.Companion</RootNamespace>
    <AssemblyName>Sofabird</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The version comes from the VERSION file in the repository root; CI adds a suffix: -p:VersionSuffix=beta.42 -->
    <VersionPrefix>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</VersionPrefix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Sofabird</Product>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <!-- Published framework-dependent to a folder and packed by Velopack (vpk pack): see the release workflow. -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sofabird.Core\Sofabird.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scenario tests drive VlcManager against a fake VLC through its internal seams (VlcBackend). -->
    <InternalsVisibleTo Include="Sofabird.Companion.Tests" />
  </ItemGroup>

  <!-- The TMDB token of the release builds (CI secret TMDB_API_TOKEN, an environment variable): never in the repository. -->
  <ItemGroup Condition="'$(TMDB_API_TOKEN)' != ''">
    <AssemblyMetadata Include="TmdbToken" Value="$(TMDB_API_TOKEN)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Our Lua pages (companion/lua/requests) are embedded as resources and installed by LuaPagesInstaller. -->
    <EmbeddedResource Include="..\lua\requests\tracks.json" LogicalName="lua.requests.tracks.json" />
    <EmbeddedResource Include="..\lua\requests\setvar.json" LogicalName="lua.requests.setvar.json" />
    <!-- The TV extension signed by Mozilla (scripts/sign_extension.py), installed into the TV browser's profile. -->
    <EmbeddedResource Include="..\tv-extension\tv@sofabird.app.xpi" LogicalName="tv-extension.xpi" Condition="Exists('..\tv-extension\tv@sofabird.app.xpi')" />
  </ItemGroup>

</Project>
