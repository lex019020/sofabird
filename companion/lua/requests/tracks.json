<?vlc --[[
  tracks.json — sofabird: lists of tracks/chapters/video parameters with the current selection.
  Goes into %APPDATA%\vlc\lua\http\requests\ together with a copy of the stock VLC pages.
  Response: JSON. Fields are absent (null) if the object does not exist (e.g. nothing is playing).
]]?>
<?vlc
local dkjson = require("dkjson")

local function lst(obj, name)
  if not obj then return nil end
  local ok, vals, texts = pcall(vlc.var.get_list, obj, name)
  if not ok then return nil end
  local items = {}
  for i, v in ipairs(vals) do items[#items + 1] = { id = v, name = texts[i] } end
  local cur = nil
  pcall(function() cur = vlc.var.get(obj, name) end)
  return { current = cur, items = items }
end

local input = vlc.object.input()
local aout  = vlc.object.aout()
local vout  = vlc.object.vout()

local out = {
  sofabird = 1,                 -- marker: the page is installed
  audio       = lst(input, "audio-es"),
  spu         = lst(input, "spu-es"),
  video       = lst(input, "video-es"),
  chapter     = lst(input, "chapter"),
  title       = lst(input, "title"),
  stereo_mode = lst(aout,  "stereo-mode"),
  aspect      = lst(vout,  "aspect-ratio"),
  crop        = lst(vout,  "crop"),
  zoom        = lst(vout,  "zoom"),
  deinterlace = lst(vout,  "deinterlace"),
}
print(dkjson.encode(out, { indent = false }))
?>
